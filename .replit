modules = ["nodejs-24", "dart-3.10", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "android-update-tools"

[[workflows.workflow]]
name = "android-update-tools"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m unittest discover -s flutter/ikram_browser/tool/tests -v && node --test flutter/ikram_browser/tool/tests/*.test.mjs && node --check flutter/ikram_browser/tool/probe_webview.mjs && bash -c 'for script in flutter/ikram_browser/tool/*.sh; do bash -n \"$script\" || exit; done' && dart flutter/ikram_browser/tool/check_domain.dart && git diff --check"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk17_headless", "apksigner"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
